# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
.codex
/.claude
SECRET_AGENTS_RULE.md

# Example build artifacts
example/build/

# FVM Version Cache
.fvm/
.fvmrc

# Local scratch / handoff docs (not for the public package)
# NOTE: .pubignore replaces .gitignore for publishing, so anything ignored in
# .gitignore must be repeated here or it ships to pub.dev.
temp_doc/
mediapipe_docs/

# Not needed in the published package (pub.dev loads README images from GitHub)
readme_img/
ROADMAP.md
AGENTS.md
CLAUDE.md
.agents/

# Vendored TensorFlow tree: consumer builds compile only src/*.cc and read
# headers from src/include — strip everything that is not a header.
src/include/**/*.cc
src/include/**/*.c
src/include/**/*.py
src/include/**/*.bin
src/include/**/*.bzl
src/include/**/*.json
src/include/**/*.md
src/include/**/BUILD
src/include/**/testdata/
src/include/**/tutorials/
